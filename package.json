{
	"name": "obsidian-xmind-pal",
	"version": "0.3.2",
	"description": "Embed and preview .xmind mind map files in your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"obsidian",
		"xmind",
		"mindmap",
		"viewer"
	],
	"author": "Moz",
	"license": "MIT",
	"dependencies": {
		"fflate": "^0.8.2",
		"xmind-embed-viewer": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/parser": "^8.65.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.0.0"
	}
}
